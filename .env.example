# Proyecto de Supabase (Settings > API)
SUPABASE_URL=""
# service_role key — NUNCA el anon key. Este proxy es el único lugar que la usa.
SUPABASE_SERVICE_ROLE_KEY=""
# Clave que debe mandar el cliente (Agendaconmigo) en el header x-api-key.
SUPABASE_PROXY_API_KEY=""

# Opcional, solo para dev-server.ts
PORT=3001
